<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets this console app use ASP.NET's HtmlRenderer, which draws Razor components to plain HTML. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuzzerGames.Web\BuzzerGames.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the table-building helpers from the engine checks instead of copying them. -->
    <Compile Include="..\BuzzerGames.Core.Checks\Table.cs" Link="Table.cs" />
    <Compile Include="..\BuzzerGames.Core.Checks\Check.cs" Link="Check.cs" />
  </ItemGroup>

</Project>
