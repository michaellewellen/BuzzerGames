<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The question files ship inside the assembly, so there are no file paths to get wrong on Railway. -->
    <EmbeddedResource Include="Data\Jeopardy\*.json" />
    <EmbeddedResource Include="Data\PressYourLuck\*.json" />
    <EmbeddedResource Include="Data\Password\*.json" />
    <EmbeddedResource Include="Data\Password\*.txt" />
    <EmbeddedResource Include="Data\Price\*.json" />
    <EmbeddedResource Include="Data\Price\*.txt" />
  </ItemGroup>

</Project>
