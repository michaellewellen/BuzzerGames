@implements IDisposable

@*
    A player's phone: their name and money, the letters used, and, on their turn, the spin pad: swirl a finger round the circle and let go.
    How fast the finger was going decides how hard the wheel spins (see wheelpad.js). Nothing on screen shows the strength: one particular
    speed returns the wheel to the same wedge, and finding it is the trick. Everything else is said out loud and run by the emcee.
*@

@if (Me is null)
{
    <main class="card center"><p class="muted">Finding your seat…</p></main>
}
else
{
    <main class="wf-phone wf-@Me.Color.ToLowerInvariant()">
        <header class="wf-phone-head">
            <span class="wf-phone-name">@Me.Name</span>
            <span class="wf-phone-color">@Me.Color</span>
        </header>

        <section class="wf-phone-money">
            <div><span class="muted">This round</span><strong>$@Me.RoundBank.ToString("N0")</strong></div>
            <div><span class="muted">Total</span><strong>$@Me.Total.ToString("N0")</strong></div>
            @if (Me.HoldsMillion || Me.WonMillion)
            {
                <div class="wf-million-badge">$1,000,000 wedge@(Me.WonMillion ? " (won)" : "")</div>
            }
        </section>

        <p class="wf-phone-status">@Status</p>

        @if (Snapshot.Phase != WheelPhase.GameOver)
        {
            @if (!string.IsNullOrEmpty(Snapshot.Category))
            {
                <div class="wf-phone-category">@(Snapshot.Prize > 0 ? $"${Snapshot.Prize:N0}" : Snapshot.Category)</div>
            }
            @if (Snapshot.Phase is not (WheelPhase.QuickReady or WheelPhase.QuickPlay or WheelPhase.QuickAnswer or WheelPhase.BonusPick or WheelPhase.BonusCategory))
            {
                <WheelLetterBoard Called="@Snapshot.CalledLetters" />
            }
        }

        @if (Snapshot.Phase == WheelPhase.QuickPlay)
        {
            <section class="wf-spin">
                @if (Me.LockedOut)
                {
                    <p class="wf-pad-msg">You're locked out of this one.</p>
                }
                else
                {
                    <button class="wf-buzz" @onpointerdown="Buzz">BUZZ!</button>
                }
            </section>
        }

        @if (Snapshot.Phase == WheelPhase.BonusPick && MyTurn)
        {
            <section class="wf-spin">
                <p class="wf-swirl-hint">Pick a card. Nobody knows what's on it yet.</p>
                <div class="wf-cardgrid">
                    @for (var i = 0; i < WheelRules.BonusCards; i++)
                    {
                        var card = i;
                        <button class="wf-cardbtn" @onclick="() => PickCard(card)">@(i + 1)</button>
                    }
                </div>
            </section>
        }

        @if (MyTurn && Snapshot.Phase == WheelPhase.Turn)
        {
            @if (Snapshot.CanSpin)
            {
                <section class="wf-spin">
                    <p class="wf-swirl-hint">Swirl the wheel with your finger, then let go. A faster swirl spins the big wheel farther.</p>
                    <div id="wf-pad" class="wf-pad" aria-label="Spin pad"><div class="wf-pad-disc"><span class="wf-pad-mark"></span></div></div>
                    <p id="wf-pad-msg" class="wf-pad-msg"></p>
                </section>
            }
            else
            {
                <p class="muted">No consonants are left. Ask the emcee about a vowel or solving.</p>
            }
        }

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        @if (Snapshot.Phase == WheelPhase.GameOver)
        {
            <p class="wf-phone-status">@(Snapshot.Winners.Contains(Me.Id) ? "You won!" : "Game over.")</p>
        }
    </main>
}

@code {
    [Parameter, EditorRequired] public WheelGame Game { get; set; } = default!;
    [Parameter, EditorRequired] public WheelSnapshot Snapshot { get; set; } = default!;
    [Parameter] public Guid Token { get; set; }
    [Parameter] public Guid PlayerId { get; set; }

    private string? _error;
    private DotNetObjectReference<WheelPlayerView>? _self;

    private WheelPlayerInfo? Me => Snapshot.Players.FirstOrDefault(p => p.Id == PlayerId);
    private bool MyTurn => Me is not null && Snapshot.Active >= 0 && Snapshot.Players[Snapshot.Active].Id == PlayerId;
    private bool PadShowing => MyTurn && Snapshot.Phase == WheelPhase.Turn && Snapshot.CanSpin;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string Status
    {
        get
        {
            if (Snapshot.Phase == WheelPhase.GameOver) return Snapshot.Message ?? "";
            switch (Snapshot.Phase)
            {
                case WheelPhase.QuickReady: return Snapshot.Message ?? "";
                case WheelPhase.QuickPlay: return Me?.LockedOut == true ? "Your buzzer is dead for this one." : "Buzz in when you know it!";
                case WheelPhase.QuickAnswer: return MyTurn ? "You buzzed in! Say your answer." : $"{Snapshot.Players[Snapshot.Active].Name} buzzed in.";
                case WheelPhase.BonusPick: return MyTurn ? "You play the bonus round!" : $"{Snapshot.Players[Snapshot.Active].Name} plays the bonus round.";
                case WheelPhase.BonusCategory or WheelPhase.BonusLetters or WheelPhase.BonusReady or WheelPhase.BonusSolve or WheelPhase.BonusOver or WheelPhase.Reveal when Snapshot.Bonus is not null:
                    return Snapshot.Message ?? "";
            }
            if (Snapshot.Active < 0) return "";
            var active = Snapshot.Players[Snapshot.Active];
            if (MyTurn)
                return Snapshot.Phase switch
                {
                    WheelPhase.Turn => "Your turn. Spin, or tell the emcee you want a vowel or to solve.",
                    WheelPhase.Spinning => "Spinning…",
                    WheelPhase.Consonant => "Call a consonant out loud.",
                    WheelPhase.Vowel => "Call a vowel out loud.",
                    WheelPhase.Reveal => "Let's see…",
                    WheelPhase.Solving => "Say your answer out loud.",
                    WheelPhase.PuzzleOver => Snapshot.Message ?? "",
                    _ => ""
                };
            return Snapshot.Phase == WheelPhase.PuzzleOver ? Snapshot.Message ?? "" : $"{active.Name} ({active.Color}) is up.";
        }
    }

    // The pad is a new element each time the turn comes round, so it is hooked up after every render (a pad already hooked up is left alone).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!PadShowing) return;
        _self ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("wheelpad.attach", "wf-pad", _self); }
        catch (JSDisconnectedException) { }
    }

    // pointerdown, not click: a click waits for the finger to lift, and a toss-up is won by milliseconds.
    private void Buzz()
    {
        var result = Game.Buzz(Token);
        _error = result.Ok ? null : result.Error;
    }

    private void PickCard(int card)
    {
        var result = Game.PickCard(Token, card);
        _error = result.Ok ? null : result.Error;
    }

    /// <summary>A finger just touched the pad: tell the room right away so the TV can swing to the wheel.</summary>
    [JSInvokable]
    public Task Grabbed() { Game.Grab(Token); return Task.CompletedTask; }

    /// <summary>The finger lifted without a real spin (a tap, or too slow).</summary>
    [JSInvokable]
    public Task Dropped() { Game.Drop(Token); return Task.CompletedTask; }

    /// <summary>Called by the pad when a finger lets go. <paramref name="power"/> is 0 to 1000, worked out from how fast the swirl was.</summary>
    [JSInvokable]
    public Task Swirled(int power) => InvokeAsync(() =>
    {
        var result = Game.Spin(Token, Math.Clamp(power, 0, WheelRules.PowerMax));
        _error = result.Ok ? null : result.Error;
        StateHasChanged();
    });

    public void Dispose() => _self?.Dispose();
}
