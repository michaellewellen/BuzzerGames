@using System.Globalization

@*
    The wheel, drawn as SVG. Angles are degrees clockwise from the top, as everywhere else. The spinning part (id wf-rotor) is turned only by
    wheel.js, so this markup never sets its transform; the Angle parameter is handed to wheel.sync() after each render for when the wheel is at
    rest (a new puzzle, a refreshed page). The three clickers (Red, Yellow, Blue) are fixed at the bottom of the rim, and the one for the
    player up is bigger and glows.
*@

<svg class="wf-wheel-svg" viewBox="-350 -350 700 700" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The wheel">
    <circle r="346" class="wf-rim-outer" />
    <g id="wf-rotor">
        @foreach (var slice in Slices)
        {
            <path d="@Wedge(slice, 0, 322)" class="@SliceClass(slice)" />
            @Text(slice)
        }
        @foreach (var peg in WheelLayout.PegAngles)
        {
            <circle cx="@Num(322 * Math.Sin(Rad(peg)))" cy="@Num(-322 * Math.Cos(Rad(peg)))" r="4.5" class="wf-peg" />
        }
    </g>
    <circle r="322" class="wf-rim-line" />
    <circle r="70" class="wf-hub" />
    @for (var i = 0; i < ClickerAngles.Count; i++)
    {
        var active = i == Active;
        <g transform="rotate(@Num(ClickerAngles[i]))">
            <g id="wf-flap-@i" class="wf-flap wf-flap-@Colors[i].ToLowerInvariant() @(active ? "active" : "")">
                <polygon points="-13,-345 13,-345 0,-292" />
            </g>
        </g>
    }
</svg>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WheelSlice> Slices { get; set; } = [];
    [Parameter] public int Active { get; set; }
    [Parameter] public double Angle { get; set; }

    /// <summary>True while a spin is being played: the wheel's turning belongs to wheel.js then, so the resting angle is not applied.</summary>
    [Parameter] public bool Hold { get; set; }

    private static IReadOnlyList<double> ClickerAngles => WheelRules.ClickerAngles;
    private static IReadOnlyList<string> Colors => WheelRules.PlayerColors;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Hold) return;
        try { await JS.InvokeVoidAsync("wheel.sync", "wf-rotor", Angle); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private static double Rad(double degrees) => degrees * Math.PI / 180.0;

    private static string Num(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Wedge(WheelSlice s, double inner, double outer)
    {
        var a0 = Rad(s.Start);
        var a1 = Rad(s.End);
        string P(double r, double a) => $"{Num(r * Math.Sin(a))} {Num(-r * Math.Cos(a))}";
        var large = s.End - s.Start > 180 ? 1 : 0;
        return $"M 0 0 L {P(outer, a0)} A {Num(outer)} {Num(outer)} 0 {large} 1 {P(outer, a1)} Z";
    }

    // Cash wedges cycle through the show's bright colors by position; the rest are fixed.
    private static readonly string[] CashColors = ["red", "orange", "yellow", "blue", "purple", "green", "pink"];

    private static string SliceClass(WheelSlice s) => s.Kind switch
    {
        SliceKind.Bankrupt => "wf-slice wf-bankrupt",
        SliceKind.LoseATurn => "wf-slice wf-lose",
        SliceKind.Million => "wf-slice wf-million",
        _ => "wf-slice wf-cash-" + CashColors[s.Wedge % CashColors.Length]
    };

    // Labels are stacked the way the show prints them. Every line is upright with its top pointing out along the spoke, so a wedge at the top
    // of the wheel reads like a column of normal text, and the first line sits out by the rim with the rest running in toward the hub.
    //   Cash:         one character per line, all the same size ($ 3 5 0 0).
    //   Bankrupt:     one letter per line, each a little smaller than the one before because the wedge narrows toward the hub.
    //   Million:      "ONE" on the first line, then M I L L I O N one letter per line, narrowing the same way (it is a 5-degree slice).
    //   Lose a Turn:  one word per line (LOSE / A / TURN), never bigger than the line above.
    private const double StackOuter = 298;   // where the first line's top edge sits (the pegs are at 322)
    private const double StackInner = 86;    // the hub is 70
    private const double LinePitch = 0.95;   // line height as a share of the type size

    private readonly record struct StackLine(string Text, double Y, double Size);

    // Punctuation takes less room than a letter, so "$1,000,000" doesn't spread out.
    private static double Weight(char c) => c switch { ',' or '.' => 0.55, _ => 1.0 };

    /// <summary>Cash: one character per line, one size that fits the stack and the wedge.</summary>
    private static List<StackLine> EvenStack(string text, double width)
    {
        var weight = text.Sum(Weight);
        var size = Math.Min(Math.Min((StackOuter - StackInner) / (weight * LinePitch), 50), width < 10 ? 14 : 62);
        var lines = new List<StackLine>();
        var y = StackOuter;
        foreach (var c in text)
        {
            var step = size * LinePitch * Weight(c);
            lines.Add(new StackLine(c.ToString(), y - step / 2, size));
            y -= step;
        }
        return lines;
    }

    /// <summary>
    /// Lines that follow the wedge's taper: each line's type is sized to the wedge's width where it sits, so the label fills the wedge and
    /// gets smaller toward the hub. <paramref name="units"/> is how wide a line is, in type sizes. The biggest fill that still fits between
    /// the rim and the hub is used. With <paramref name="neverGrow"/> a line is never bigger than the one above it.
    /// </summary>
    private static List<StackLine> TaperedStack(IReadOnlyList<string> texts, IReadOnlyList<double> units, double widthDegrees, bool neverGrow)
    {
        var halfWidth = Math.Sin(Rad(widthDegrees / 2));   // wedge width at radius r is 2 * r * halfWidth
        for (var fill = 0.9; fill > 0.05; fill -= 0.01)
        {
            var lines = new List<StackLine>();
            var y = StackOuter;
            var previous = double.MaxValue;
            for (var i = 0; i < texts.Count; i++)
            {
                var size = 20.0;
                for (var pass = 0; pass < 3; pass++)   // the width depends on where the line ends up, which depends on its size
                    size = Math.Min(fill * 2 * (y - size * LinePitch / 2) * halfWidth / units[i], 60);
                if (neverGrow) size = Math.Min(size, previous);
                previous = size;
                var step = size * LinePitch;
                lines.Add(new StackLine(texts[i], y - step / 2, size));
                y -= step;
            }
            if (y >= StackInner) return lines;
        }
        return [];
    }

    private RenderFragment Text(WheelSlice s) => builder =>
    {
        var width = s.End - s.Start;
        if (s.Kind == SliceKind.Bankrupt && width < 10) return;   // the thin Bankrupt slices beside the Million slice stay plain black

        List<StackLine> lines = s.Kind switch
        {
            SliceKind.Bankrupt => TaperedStack("BANKRUPT".Select(c => c.ToString()).ToList(), Enumerable.Repeat(0.7, 8).ToList(), width, neverGrow: false),
            SliceKind.Million => TaperedStack(["ONE", .. "MILLION".Select(c => c.ToString())], [2.2, .. Enumerable.Repeat(1.0, 7)], width, neverGrow: false),
            SliceKind.LoseATurn => TaperedStack(["LOSE", "A", "TURN"], [2.5, 0.7, 2.5], width, neverGrow: true),
            _ => EvenStack(s.Label.ToUpperInvariant(), width)
        };

        var cls = "wf-slice-text " + (s.Kind == SliceKind.Cash ? "wf-text-cash" : "wf-text-" + s.Kind.ToString().ToLowerInvariant());
        var seq = 0;
        builder.OpenElement(seq++, "g");
        builder.AddAttribute(seq++, "transform", $"rotate({Num(s.Start + width / 2)})");
        foreach (var line in lines)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", "0");
            builder.AddAttribute(seq++, "y", Num(-line.Y));
            builder.AddAttribute(seq++, "class", cls);
            builder.AddAttribute(seq++, "font-size", Num(line.Size));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "dominant-baseline", "central");
            builder.AddContent(seq++, line.Text);
            builder.CloseElement();
        }
        builder.CloseElement();
    };
}
