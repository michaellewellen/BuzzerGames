@*
    The emcee's phone. It shows everything the big screen and the players are not allowed to see yet: the password
    being played, the big word and the other answers to accept. It runs the judging: rule on each guess, throw out a bad clue,
    rule on the big word, and move on.
    During play the players press their own buttons, but the buttons that matter here also work for them, in case
    somebody's phone dies.
*@

<main class="phone emcee pw-emcee">
    <header class="phone-header">
        <span class="pill">EMCEE</span>
        @if (InBonus)
        {
            <span class="phone-sub">Room @Snapshot.Code · Bonus round · @Snapshot.TeamName(Snapshot.BonusTeam)</span>
        }
        else
        {
            <span class="phone-sub">Room @Snapshot.Code · Puzzle @Snapshot.PuzzleNumber · Word @Snapshot.WordNumber of @Snapshot.WordsPerPuzzle</span>
        }
    </header>

    <PasswordScoreStrip Snapshot="Snapshot" />

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @switch (Snapshot.Phase)
    {
        case PasswordPhase.Control:
            @SecretPanel
            <p class="hint">@(Snapshot.Message is { } flip ? flip + " " : "")<strong>@Snapshot.TeamName(Snapshot.ControlTeam)</strong> has control. They choose from their phones:</p>
            <div class="judge-buttons">
                <button class="btn btn-yes" @onclick="() => Act(Game.ChooseControl(Token, true))">Play<small>@Snapshot.TeamName(Snapshot.ControlTeam) clues first</small></button>
                <button class="btn btn-quiet" @onclick="() => Act(Game.ChooseControl(Token, false))">Pass<small>@Snapshot.TeamName(1 - Snapshot.ControlTeam) clues first</small></button>
            </div>
            break;

        case PasswordPhase.Clue:
            @SecretPanel
            @CluesList
            <p class="hint"><strong>@Snapshot.Giver(Snapshot.TurnTeam)?.Name</strong> (@Snapshot.TeamName(Snapshot.TurnTeam)) is typing clue @(PasswordGame.CluesPerSide - Snapshot.Teams[Snapshot.TurnTeam].CluesLeft + 1) of @PasswordGame.CluesPerSide.</p>
            <label class="hint" for="clue">Or type it for them:</label>
            <input id="clue" class="text-input" placeholder="One word" maxlength="@PasswordGame.ClueMaxLength"
                   autocapitalize="none" autocomplete="off" autocorrect="off" spellcheck="false"
                   @bind="_clue" @bind:event="oninput" @onkeydown="OnClueKey" />
            <button class="btn btn-wide" @onclick="SendClue">Send clue for them</button>
            break;

        case PasswordPhase.Guess:
            @SecretPanel
            @CluesList
            <p class="hint"><strong>@Snapshot.Guesser(Snapshot.TurnTeam)?.Name</strong> says a guess out loud. Were they right?</p>
            <div class="judge-buttons">
                <button class="btn btn-yes" @onclick="() => Act(Game.JudgeGuess(Token, true))">✓ Correct<small>@Snapshot.TeamName(Snapshot.TurnTeam) got the word</small></button>
                <button class="btn btn-no" @onclick="() => Act(Game.JudgeGuess(Token, false))">✗ Wrong</button>
            </div>
            <button class="btn btn-quiet btn-wide" @onclick="() => Act(Game.RejectClue(Token))">Throw out that clue<small>(more than one word, part of the answer…)</small></button>
            break;

        case PasswordPhase.PuzzleGuess:
            @SecretPanel
            <p class="hint">
                <strong>@Snapshot.Attempting?.Name</strong> (@Snapshot.TeamName(Snapshot.Attempting?.Team ?? 0)) guesses the big word.
                @if (Snapshot.AttemptsLeft > 1)
                {
                    <span>@Snapshot.AttemptsLeft tries are left, passing around the table.</span>
                }
            </p>
            <div class="judge-buttons">
                <button class="btn btn-yes" @onclick="() => Act(Game.JudgePuzzleGuess(Token, true))">✓ Correct<small>+@Snapshot.PuzzleValue for @Snapshot.TeamName(Snapshot.Attempting?.Team ?? 0)</small></button>
                <button class="btn btn-no" @onclick="() => Act(Game.JudgePuzzleGuess(Token, false))">✗ Wrong</button>
            </div>
            break;

        case PasswordPhase.WordResult:
            @SecretPanel
            @CluesList
            <p class="hint">@Snapshot.Message</p>
            <button class="btn btn-start btn-wide" @onclick="() => Act(Game.Continue(Token))">Next word</button>
            break;

        case PasswordPhase.PuzzleResult:
            @SecretPanel
            <p class="hint">@Snapshot.Message</p>
            <button class="btn btn-start btn-wide" @onclick="() => Act(Game.Continue(Token))">
                @(Snapshot.Teams.Any(t => t.Score >= Snapshot.WinScore) ? "On to the bonus round" : "Next puzzle")
            </button>
            break;

        case PasswordPhase.BonusReady:
            <p class="winner">@Snapshot.Message</p>
            <PasswordBonusLetters Snapshot="Snapshot" />
            <p class="hint"><strong>@Snapshot.FindPlayer(Snapshot.BonusGiverId)?.Name</strong> faces the TV and gives the clues.
                <strong>@Snapshot.FindPlayer(Snapshot.BonusGuesserId)?.Name</strong> sits with their back to it and guesses. Nobody uses their phone.</p>
            <button class="btn btn-quiet btn-wide" @onclick="() => Act(Game.BonusSwapRoles(Token))">Swap who gives the clues</button>
            <button class="btn btn-start btn-wide" @onclick="() => Act(Game.StartBonus(Token))">Start the 60-second clock</button>
            break;

        case PasswordPhase.BonusPlay:
            <PasswordBonusClock Snapshot="Snapshot" Class="small" />
            <PasswordBonusLetters Snapshot="Snapshot" />
            @if (Snapshot.BonusCurrent >= 0)
            {
                <div class="emcee-clue bonus-emcee-word">
                    <p class="emcee-clue-meta">Letter @Snapshot.BonusSlots[Snapshot.BonusCurrent].Letter · $@(PasswordGame.BonusLetterValue) · @Snapshot.BonusCorrect of @Snapshot.BonusSlots.Count so far</p>
                    <p class="bonus-emcee-text">@Snapshot.BonusSlots[Snapshot.BonusCurrent].Word</p>
                </div>
            }
            <div class="bonus-buttons">
                <button class="btn bonus-btn bonus-right" aria-label="Got it right" @onclick="() => Act(Game.BonusCorrect(Token))">✓<small>Got it</small></button>
                <button class="btn bonus-btn bonus-pass" aria-label="Pass" @onclick="() => Act(Game.BonusPass(Token))">PASS</button>
                <button class="btn bonus-btn bonus-wrong" aria-label="Clue rule broken" @onclick="() => Act(Game.BonusZap(Token))">✗<small>Bad clue</small></button>
            </div>
            <p class="hint">✓ the guesser said the word. PASS moves on, and the word comes back later if there's time. ✗ a clue rule was broken, so the word is zapped.</p>
            break;

        case PasswordPhase.BonusResult:
            <p class="winner">@Snapshot.Message</p>
            <PasswordBonusLetters Snapshot="Snapshot" />
            <button class="btn btn-start btn-wide" @onclick="() => Act(Game.Continue(Token))">Finish the game</button>
            break;

        case PasswordPhase.GameOver:
            <p class="winner">@Snapshot.Message</p>
            <button class="btn btn-start btn-wide" @onclick="() => Act(Game.Restart(Token, samePlayers: true))">Play again, same players</button>
            <button class="btn btn-wide" @onclick="() => Act(Game.Restart(Token, samePlayers: false))">Play again, new players</button>
            <a class="back-link" href="/">All games</a>
            break;
    }
</main>

@code {
    [Parameter, EditorRequired] public PasswordGame Game { get; set; } = default!;
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public Guid Token { get; set; }

    private bool InBonus => Snapshot.Phase is PasswordPhase.BonusReady or PasswordPhase.BonusPlay or PasswordPhase.BonusResult;

    private string? _error;
    private string _clue = "";
    private PasswordPhase _lastPhase;
    private int _lastClueCount;

    // An error only makes sense for the screen it appeared on, and a new turn starts with an empty clue box.
    protected override void OnParametersSet()
    {
        if (Snapshot.Phase == _lastPhase && Snapshot.Clues.Count == _lastClueCount) return;
        _lastPhase = Snapshot.Phase;
        _lastClueCount = Snapshot.Clues.Count;
        _error = null;
        _clue = "";
    }

    private void Act(Result result) => _error = result.Ok ? null : result.Error;

    private void SendClue()
    {
        var result = Game.SubmitClue(Token, _clue);
        _error = result.Ok ? null : result.Error;
        if (result.Ok) _clue = "";
    }

    private void OnClueKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendClue();
    }

    // The secrets: the password in play, the big word, and the other answers to accept. Only the emcee's phone ever draws this.
    private RenderFragment SecretPanel => @<div class="emcee-clue pw-secret-panel">
        <p class="emcee-clue-meta">@Snapshot.PuzzleKind · Puzzle @Snapshot.PuzzleNumber is worth @Snapshot.PuzzleValue</p>
        <p class="emcee-clue-text">Password: <strong>@Snapshot.CurrentWord</strong></p>
        <p class="emcee-clue-answer">Big word: @Snapshot.BigWord@(Snapshot.BigWordAlso is { } also ? $" (also accept: {also})" : "")</p>
        <ol class="pw-emcee-words">
            @foreach (var word in Snapshot.Words)
            {
                <li class="@word.State.ToString().ToLowerInvariant()">@word.Text <small>@StateText(word.State)</small></li>
            }
        </ol>
    </div>;

    private RenderFragment CluesList => @<ul class="pw-clues pw-clues-phone">
        @foreach (var clue in Snapshot.Clues)
        {
            <li class="pw-clue @PasswordText.TeamClass(clue.Team) @PasswordText.OutcomeClass(clue.Outcome)">
                <span class="pw-clue-team">@Snapshot.TeamName(clue.Team)</span>
                <span class="pw-clue-text">@clue.Text</span>
                <span class="pw-clue-mark">@PasswordText.OutcomeMark(clue.Outcome)</span>
            </li>
        }
    </ul>;

    private static string StateText(WordState state) => state switch
    {
        WordState.Current => "· in play",
        WordState.Solved => "· guessed",
        WordState.Posted => "· posted",
        _ => "· waiting"
    };
}
