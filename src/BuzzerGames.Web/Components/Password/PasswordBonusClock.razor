@*
    The bonus round's clock. The server decides when time is up (the game ends the round by itself); this only
    draws the countdown. bg.js counts it down smoothly in the browser: it reads data-clock-end (which changes only
    when a new clock starts) and data-clock-ms (how long was left when this was drawn), so a phone's or TV's own
    clock being a little off doesn't matter.
*@

@if (Snapshot.Phase == PasswordPhase.BonusPlay && Snapshot.BonusEndsAtUtc is { } end)
{
    <div class="bonus-clock @Class" data-clock-end="@end.Ticks" data-clock-ms="@Snapshot.BonusMillisLeft">@((int)Math.Ceiling(Snapshot.BonusMillisLeft / 1000.0))</div>
}
else if (Snapshot.Phase == PasswordPhase.BonusReady)
{
    <div class="bonus-clock @Class">@Snapshot.BonusSeconds</div>
}
else
{
    <div class="bonus-clock done @Class">@(Snapshot.BonusCorrect == Snapshot.BonusSlots.Count ? "ALL TEN!" : "TIME!")</div>
}

@code {
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "";
}
