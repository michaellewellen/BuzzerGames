@inject IJSRuntime JS

@*
    The lobby, in two flavors (the same two as the other games'):
      Phone flavor (BoardMode = false): join as Emcee or on Team A or Team B, and Start Game once the table is full.
      Big-screen flavor (BoardMode = true): a giant QR code and the roster. It never takes a seat.
*@

<main class="lobby pw-lobby @(BoardMode ? "board-mode" : "")">
    <header class="lobby-header">
        <h1 class="logo">PASSWORD PLUS</h1>
        <p class="room-line">Room <span class="room-code">@Snapshot.Code</span></p>
    </header>

    <div class="lobby-grid">

        <section class="card">
            @if (BoardMode)
            {
                <h2>Take a seat</h2>
                <p>Scan the QR code with your phone, then choose <strong>Emcee</strong>, <strong>Team A</strong> or <strong>Team B</strong>. Each team has two players.</p>
            }
            else if (Seat.Role != Role.Spectator)
            {
                <h2>You're in!</h2>
                <p>
                    You joined as <strong>@MyName</strong>
                    (@MyRole). Waiting for the rest of the table…
                </p>
            }
            else if (_pendingRole is not null)
            {
                <h2>Join as @PendingLabel</h2>
                <input class="text-input" placeholder="Your name" maxlength="@PasswordGame.NameMaxLength"
                       @bind="_name" @bind:event="oninput" @onkeydown="OnKeyDown" />
                <div class="button-row">
                    <button class="btn" @onclick="ConfirmJoin">Join</button>
                    <button class="btn btn-quiet" @onclick="CancelJoin">Back</button>
                </div>
            }
            else
            {
                <h2>Join the game</h2>
                <div class="button-column">
                    <button class="btn" disabled="@(Snapshot.EmceeName is not null)" @onclick="() => BeginJoin(Role.Emcee, 0)">
                        Join as Emcee
                    </button>
                    <button class="btn pw-join-a" disabled="@TeamFull(0)" @onclick="() => BeginJoin(Role.Player, 0)">
                        Join Team A
                    </button>
                    <button class="btn pw-join-b" disabled="@TeamFull(1)" @onclick="() => BeginJoin(Role.Player, 1)">
                        Join Team B
                    </button>
                </div>
            }

            @if (Snapshot.CanStart)
            {
                <button class="btn btn-start" @onclick="OnStart">Start Game</button>
            }

            @if (Error is not null)
            {
                <p class="error">@Error</p>
            }
        </section>

        <section class="card">
            <h2>At the table</h2>
            <ul class="roster">
                <li class="@(Snapshot.EmceeName is null ? "open" : "filled")">
                    <span class="seat-label">Emcee</span>
                    <span class="seat-name">@(Snapshot.EmceeName ?? "waiting…")</span>
                </li>
                @for (var team = 0; team < PasswordGame.Teams; team++)
                {
                    var t = team;
                    @for (var slot = 0; slot < PasswordGame.TeamSize; slot++)
                    {
                        var player = slot < Snapshot.Teams[t].PlayerIds.Count ? Snapshot.FindPlayer(Snapshot.Teams[t].PlayerIds[slot]) : null;
                        <li class="@(player is null ? "open" : "filled") @PasswordText.TeamClass(t)">
                            <span class="seat-label">@Snapshot.Teams[t].Name · Player @(slot + 1)</span>
                            <span class="seat-name">@(player?.Name ?? "waiting…")</span>
                        </li>
                    }
                }
            </ul>
        </section>

        <section class="card qr-card">
            <h2>Scan to join</h2>
            <div id="qr-@Snapshot.Code" class="qr"></div>
            <p class="join-url">@_joinUrl</p>
        </section>

    </div>
</main>

@code {
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public Seat Seat { get; set; }
    [Parameter] public bool BoardMode { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<(Role Role, string Name, int Team)> OnJoin { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }

    private Role? _pendingRole;
    private int _pendingTeam;
    private string _name = "";
    private string _joinUrl = "";

    private bool TeamFull(int team) => Snapshot.Teams[team].PlayerIds.Count >= PasswordGame.TeamSize;

    private string PendingLabel => _pendingRole == Role.Emcee ? "emcee" : Snapshot.Teams[_pendingTeam].Name;

    private PasswordPlayerInfo? MePlayer => Snapshot.FindPlayer(Seat.PlayerId);

    private string MyName => Seat.Role == Role.Emcee ? Snapshot.EmceeName ?? "" : MePlayer?.Name ?? "";

    private string MyRole => Seat.Role == Role.Emcee
        ? "emcee"
        : MePlayer is { } p ? $"{Snapshot.Teams[p.Team].Name}, player {p.Slot + 1}" : "player";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The QR code points at the phone address (/password-plus/ABCD), never at the /board address.
        _joinUrl = await JS.InvokeAsync<string>("bg.renderQr", $"qr-{Snapshot.Code}", $"/password-plus/{Snapshot.Code}");
        StateHasChanged();
    }

    private void BeginJoin(Role role, int team) { _pendingRole = role; _pendingTeam = team; _name = ""; }
    private void CancelJoin() => _pendingRole = null;

    private async Task ConfirmJoin()
    {
        if (_pendingRole is null) return;
        await OnJoin.InvokeAsync((_pendingRole.Value, _name, _pendingTeam));
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmJoin();
    }
}
