@* The ten letters of the bonus round, typed out: A B C D ... Each shows whether it was won, zapped, passed, or is up now. *@

<div class="bonus-letters">
    @foreach (var slot in Snapshot.BonusSlots)
    {
        <span class="bonus-letter @PasswordText.BonusClass(slot.State)">@slot.Letter</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;
}
