@*
    The big screen: the puzzle's five word slots, the clues given on the current word, and the scores.
    Nothing here is clickable; the emcee and the players play from their phones.

    The rule for this screen is that it is shown to the whole room, so it must never show the password that is
    being played, or the big word, until the game has revealed them. A word slot only shows its text once the word has
    been guessed or posted, and the big word only shows once the puzzle is over.
*@

<main class="tv pw-tv">
    <header class="tv-top">
        @if (InBonus)
        {
            <span>PASSWORD PLUS · BONUS ROUND</span>
            <span>@Snapshot.TeamName(Snapshot.BonusTeam) · Room @Snapshot.Code</span>
        }
        else
        {
            <span>PASSWORD PLUS · Puzzle @Snapshot.PuzzleNumber · worth @Snapshot.PuzzleValue</span>
            <span>First to @Snapshot.WinScore wins · Room @Snapshot.Code</span>
        }
    </header>

    @if (InBonus)
    {
        <section class="pw-panel pw-bonus @PasswordText.TeamClass(Snapshot.BonusTeam)">
            <p class="pw-kind">TEN WORDS · ONE PER LETTER · <strong>$100 A WORD</strong> · <strong>$10,000 FOR ALL TEN</strong></p>

            <PasswordBonusClock Snapshot="Snapshot" />
            <PasswordBonusLetters Snapshot="Snapshot" />

            @switch (Snapshot.Phase)
            {
                case PasswordPhase.BonusReady:
                    <p class="bonus-instruction"><strong>@BonusGiver?.Name</strong>: face the screen and give the clues.</p>
                    <p class="bonus-instruction"><strong>@BonusGuesser?.Name</strong>: turn your back to the screen and guess!</p>
                    <p class="pw-status @PasswordText.TeamClass(Snapshot.BonusTeam)">Waiting for the emcee to start the clock…</p>
                    break;

                case PasswordPhase.BonusPlay:
                    @if (Snapshot.BonusCurrent >= 0)
                    {
                        <div class="bonus-word">@Snapshot.BonusSlots[Snapshot.BonusCurrent].Word</div>
                    }
                    <p class="bonus-instruction">One word at a time. Say "pass" to come back to it later.</p>
                    break;

                default:
                    <ul class="bonus-review">
                        @foreach (var slot in Snapshot.BonusSlots)
                        {
                            <li class="@PasswordText.BonusClass(slot.State)">
                                <span class="bonus-review-letter">@slot.Letter</span>
                                <span class="bonus-review-word">@slot.Word</span>
                                <span class="bonus-review-mark">@PasswordText.BonusMark(slot.State)</span>
                            </li>
                        }
                    </ul>
                    <p class="winner">@Snapshot.Message</p>
                    break;
            }
        </section>
    }
    else if (Snapshot.Phase == PasswordPhase.GameOver)
    {
        <section class="pw-panel">
            <h1 class="pyl-title">GAME OVER</h1>
            <p class="winner">@Snapshot.Message</p>
            <p class="hint">The emcee can start another game from their phone.</p>
        </section>
    }
    else
    {
        <section class="pw-panel">
            <p class="pw-kind">The big word is <strong>@PasswordText.KindPhrase(Snapshot.PuzzleKind)</strong></p>

            <div class="pw-bigword @(Snapshot.BigWordRevealed ? "revealed" : "")">
                @(Snapshot.BigWordRevealed ? Snapshot.BigWord : "? ? ? ?")
            </div>

            <div class="pw-words">
                @foreach (var word in Snapshot.Words)
                {
                    var shown = word.State is WordState.Solved or WordState.Posted;
                    <div class="pw-word @word.State.ToString().ToLowerInvariant()">
                        <span class="pw-word-num">@word.Number</span>
                        <span class="pw-word-text">@(shown ? word.Text : "")</span>
                    </div>
                }
            </div>

            @if (Snapshot.Clues.Count > 0)
            {
                <ul class="pw-clues">
                    @foreach (var clue in Snapshot.Clues)
                    {
                        <li class="pw-clue @PasswordText.TeamClass(clue.Team) @PasswordText.OutcomeClass(clue.Outcome)">
                            <span class="pw-clue-team">@Snapshot.TeamName(clue.Team)</span>
                            <span class="pw-clue-text">@clue.Text</span>
                            <span class="pw-clue-mark">@PasswordText.OutcomeMark(clue.Outcome)</span>
                        </li>
                    }
                </ul>
            }

            <p class="pw-status @StatusClass">@Status</p>
        </section>
    }

    <PasswordScoreStrip Snapshot="Snapshot" />
</main>

@code {
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;

    private bool InBonus => Snapshot.Phase is PasswordPhase.BonusReady or PasswordPhase.BonusPlay or PasswordPhase.BonusResult;
    private PasswordPlayerInfo? BonusGiver => Snapshot.FindPlayer(Snapshot.BonusGiverId);
    private PasswordPlayerInfo? BonusGuesser => Snapshot.FindPlayer(Snapshot.BonusGuesserId);

    private string StatusClass => Snapshot.TurnTeam >= 0 ? PasswordText.TeamClass(Snapshot.TurnTeam) : "";

    private string Status
    {
        get
        {
            var s = Snapshot;
            switch (s.Phase)
            {
                case PasswordPhase.Control:
                    var control = s.TeamName(s.ControlTeam);
                    return s.Message is { } flip
                        ? $"{flip} {control}: play or pass?"
                        : $"{control} has control: play or pass?";

                case PasswordPhase.Clue:
                    var giver = s.Giver(s.TurnTeam);
                    var clueNumber = PasswordGame.CluesPerSide - s.Teams[s.TurnTeam].CluesLeft + 1;
                    return $"{giver?.Name} ({s.TeamName(s.TurnTeam)}) is giving clue {clueNumber} of {PasswordGame.CluesPerSide}…";

                case PasswordPhase.Guess:
                    return $"{s.Guesser(s.TurnTeam)?.Name}: what's the word?";

                case PasswordPhase.PuzzleGuess:
                    var tries = s.AttemptsLeft > 1 ? $" ({s.AttemptsLeft} tries left, passing around)" : "";
                    return $"{s.Attempting?.Name}: what's the big word?{tries}";

                default:
                    return s.Message ?? "";
            }
        }
    }
}
