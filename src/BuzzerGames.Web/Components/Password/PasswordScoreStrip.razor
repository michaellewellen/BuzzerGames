@* The two teams: score, who has control, who is on the clock, and who is giving or guessing. Shared by the big screen and every phone. *@

<div class="scores pw-scores">
    @foreach (var team in Snapshot.Teams)
    {
        <div class="score pw-team @PasswordText.TeamClass(team.Index) @(team.HasControl ? "control" : "") @(team.OnClock ? "clock" : "")">
            <span class="score-name">
                @team.Name
                @if (team.HasControl)
                {
                    <span class="control-tag">CONTROL</span>
                }
            </span>
            <span class="score-value">@team.Score</span>
            <span class="pw-members">
                @foreach (var id in team.PlayerIds)
                {
                    var p = Snapshot.FindPlayer(id);
                    if (p is null) continue;
                    <span class="pw-member @(p.IsAttempting ? "attempting" : "")">
                        @p.Name<small>@RoleText(p)</small>
                    </span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;

    private static string RoleText(PasswordPlayerInfo p) =>
        p.IsGiver ? " · clues" : p.IsGuesser ? " · guesses" : "";
}
