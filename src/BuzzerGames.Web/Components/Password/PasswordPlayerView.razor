@*
    A player's phone. It changes with the player's job on the current word:
      the CLUE-GIVER of either team sees the secret word, and the one whose team is on the clock types a clue;
      the GUESSER never sees the word and just listens, then says a guess out loud for the emcee to rule on.
    The big word is never on a player's phone at all. Everyone reads the clues off the big screen.
*@

<main class="phone player pw-player @PasswordText.TeamClass(Me.Team)">
    <header class="phone-header">
        <span class="pill">@Me.Name</span>
        <span class="my-score">@MyTeam.Name · @MyTeam.Score</span>
    </header>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @switch (Snapshot.Phase)
    {
        case PasswordPhase.Control:
            @if (MyTeamHasControl)
            {
                <p class="big-message">Your team has control</p>
                <p class="hint">Play: your team's clue-giver goes first. Pass: the other team does.</p>
                <button class="btn btn-start btn-wide" @onclick="() => Act(Game.ChooseControl(Token, true))">
                    PLAY<small>@MyTeam.Name gives the first clue</small>
                </button>
                <button class="btn btn-quiet btn-wide" @onclick="() => Act(Game.ChooseControl(Token, false))">
                    PASS<small>@Snapshot.TeamName(1 - Me.Team) gives the first clue</small>
                </button>
            }
            else
            {
                <p class="big-message">@Snapshot.TeamName(Snapshot.ControlTeam) has control</p>
                <p class="hint">They are choosing whether to play or pass.</p>
            }
            <p class="hint">@RoleLine</p>
            break;

        case PasswordPhase.Clue:
            @if (Me.IsGiver)
            {
                @SecretWord
                @if (MyTeamOnClock)
                {
                    <p class="big-message">Your clue!</p>
                    <p class="hint">Say ONE word out loud to @Snapshot.Guesser(Me.Team)?.Name. No part of the password.</p>
                }
                else
                {
                    <p class="big-message">@Snapshot.TeamName(Snapshot.TurnTeam) is giving a clue</p>
                    <p class="hint">Keep the word to yourself!</p>
                }
            }
            else if (MyTeamOnClock)
            {
                <p class="big-message">Your guess!</p>
                <p class="hint">Listen to @Snapshot.Giver(Me.Team)?.Name and say your guess out loud.</p>
            }
            else
            {
                <p class="big-message">@Snapshot.TeamName(Snapshot.TurnTeam) is giving a clue</p>
                <p class="hint">Listen up.</p>
            }
            break;

        case PasswordPhase.PuzzleGuess:
            @if (Me.IsAttempting)
            {
                <p class="big-message">Your shot at the big word!</p>
                <p class="hint">The words on the screen all hint at it. Say your guess out loud.</p>
            }
            else
            {
                <p class="big-message">@Snapshot.Attempting?.Name is guessing the big word</p>
                <p class="hint">Watch the big screen.</p>
            }
            break;

        case PasswordPhase.WordResult:
        case PasswordPhase.PuzzleResult:
            <p class="big-message">@Snapshot.Message</p>
            <p class="hint">Waiting on the emcee…</p>
            break;

        case PasswordPhase.BonusReady:
        case PasswordPhase.BonusPlay:
        case PasswordPhase.BonusResult:
            @if (Snapshot.Phase == PasswordPhase.BonusResult)
            {
                <p class="big-message">@Snapshot.Message</p>
                <p class="hint">Waiting on the emcee…</p>
            }
            else if (Me.Id == Snapshot.BonusGiverId)
            {
                <p class="big-message">Face the big screen!</p>
                <p class="hint">Give @Snapshot.FindPlayer(Snapshot.BonusGuesserId)?.Name clues out loud, one at a time. No part of the word. Put your phone down.</p>
            }
            else if (Me.Id == Snapshot.BonusGuesserId)
            {
                <p class="big-message">Back to the screen!</p>
                <p class="hint">Don't peek. Listen to @Snapshot.FindPlayer(Snapshot.BonusGiverId)?.Name and guess out loud. Put your phone down.</p>
            }
            else
            {
                <p class="big-message">@Snapshot.TeamName(Snapshot.BonusTeam) is playing the bonus round</p>
                <p class="hint">Watch the big screen.</p>
            }
            break;

        case PasswordPhase.GameOver:
            <p class="big-message">@(Snapshot.Winners.Contains(Me.Team) ? "Your team won! 🎉" : "Game over")</p>
            <p class="hint">@Snapshot.Message</p>
            break;
    }

    <PasswordScoreStrip Snapshot="Snapshot" />
</main>

@code {
    [Parameter, EditorRequired] public PasswordGame Game { get; set; } = default!;
    [Parameter, EditorRequired] public PasswordSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public Guid Token { get; set; }
    [Parameter, EditorRequired] public Guid PlayerId { get; set; }

    private string? _error;
    private PasswordPhase _lastPhase;
    private int _lastTurn;

    private PasswordPlayerInfo Me => Snapshot.FindPlayer(PlayerId)!;
    private PasswordTeamInfo MyTeam => Snapshot.Teams[Me.Team];
    private bool MyTeamHasControl => Snapshot.ControlTeam == Me.Team;
    private bool MyTeamOnClock => Snapshot.TurnTeam == Me.Team;

    private string RoleLine => Me.IsGiver
        ? "In this puzzle you give the clues."
        : "In this puzzle you guess.";

    // An error only makes sense for the screen it appeared on.
    protected override void OnParametersSet()
    {
        if (Snapshot.Phase == _lastPhase && Snapshot.TurnTeam == _lastTurn) return;
        _lastPhase = Snapshot.Phase;
        _lastTurn = Snapshot.TurnTeam;
        _error = null;
    }

    private void Act(Result result) => _error = result.Ok ? null : result.Error;

    // The secret word. Only a clue-giver's phone ever draws this.
    private RenderFragment SecretWord => @<div class="pw-secret">
        <span class="pw-secret-label">The word is</span>
        <strong class="pw-secret-word">@Snapshot.CurrentWord</strong>
    </div>;
}
