@page "/jeopardy/{Code}"
@page "/jeopardy/{Code}/board"
@implements IDisposable
@inject GameRoomManager Rooms
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Jeopardy · @Code.ToUpperInvariant()</PageTitle>

@*
    This one page is every screen in the game, and it answers two web addresses:

      /jeopardy/ABCD         for people. Phones scan the QR code and land here. It offers the join buttons
                             and remembers which seat this phone took.
      /jeopardy/ABCD/board   for the big screen. It never joins; it only watches. It shows the QR code
                             while people join, then turns into the game board.

    Then it asks two questions: what phase is the game in, and who is this device? The answers pick the view.
*@

@if (_game is null)
{
    <main class="card center">
        <h1>Game not found</h1>
        <p>There's no game with the code <strong>@Code.ToUpperInvariant()</strong>. It may have ended, or the server may have restarted.</p>
        <a class="btn" href="/jeopardy">Start or join a game</a>
    </main>
}
else if (!_ready)
{
    <main class="card center"><p class="muted">Connecting…</p></main>
}
else if (_snapshot.Phase == GamePhase.Lobby)
{
    @* Note the @ in Error="@_error". Without it Razor passes the literal text "_error" instead of the variable's value. *@
    <LobbyView Snapshot="_snapshot" Seat="_seat" BoardMode="_boardMode" Error="@_error" OnJoin="JoinAsync" OnStart="Start" />
}
else if (_boardMode)
{
    <BoardView Snapshot="_snapshot" />
}
else if (_seat.Role == Role.Emcee)
{
    <EmceeView Game="_game" Snapshot="_snapshot" Token="_token" />
}
else if (_seat.Role == Role.Player)
{
    <PlayerView Game="_game" Snapshot="_snapshot" Token="_token" PlayerId="_seat.PlayerId!.Value" />
}
else
{
    <BoardView Snapshot="_snapshot" />
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private JeopardyGame? _game;
    private GameSnapshot _snapshot = default!;
    private Seat _seat = new(Role.Spectator);
    private Guid _token;
    private bool _ready;
    private bool _boardMode;
    private string? _error;

    // Each phone remembers its seat in this browser's storage under a key like "bg.jeopardy.BCDF".
    // Testing aid: opening the page as .../ABCD?seat=2 gives that tab its own saved seat, so one browser can play
    // several people. Real phones don't use it, so for them it is just the room code as before.
    private string StorageKey
    {
        get
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
            var slot = query.TryGetValue("seat", out var v) ? v.ToString() : "";
            return $"bg.jeopardy.{Code.ToUpperInvariant()}" + (slot.Length > 0 ? $".{slot}" : "");
        }
    }

    protected override void OnInitialized()
    {
        // Which of the two addresses are we on?
        _boardMode = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/')
            .EndsWith("/board", StringComparison.OrdinalIgnoreCase);

        _game = Rooms.Find(Code);
        if (_game is null) return;

        _snapshot = _game.Snapshot();
        _game.Changed += OnGameChanged;

        // The big screen never takes a seat, so there is nothing to load from the browser.
        if (_boardMode) _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _game is null || _boardMode) return;

        // Did this phone already take a seat in this game (before a refresh, or a locked screen)?
        var saved = await JS.InvokeAsync<string?>("bg.getItem", StorageKey);
        if (Guid.TryParse(saved, out var token))
        {
            _token = token;
            _seat = _game.GetSeat(token);
        }

        _ready = true;
        StateHasChanged();
    }

    // The game just changed (someone buzzed, the emcee judged...). Grab a fresh snapshot and redraw.
    // InvokeAsync hops onto this page's own thread, because the change came from another phone's call.
    private void OnGameChanged() => _ = InvokeAsync(() =>
    {
        _snapshot = _game!.Snapshot();
        StateHasChanged();
    });

    private async Task JoinAsync((Role Role, string Name) request)
    {
        _error = null;
        var result = request.Role == Role.Emcee
            ? _game!.JoinEmcee(request.Name)
            : _game!.JoinPlayer(request.Name);

        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        _token = result.Token;
        _seat = _game.GetSeat(_token);
        await JS.InvokeVoidAsync("bg.setItem", StorageKey, _token.ToString());
    }

    private void Start()
    {
        var result = _game!.Start();
        _error = result.Ok ? null : result.Error;
    }

    public void Dispose()
    {
        if (_game is not null) _game.Changed -= OnGameChanged;
    }
}
