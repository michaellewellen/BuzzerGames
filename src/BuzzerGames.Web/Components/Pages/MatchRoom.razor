@page "/match-game/{Code}"
@page "/match-game/{Code}/board"
@implements IDisposable
@inject MatchRoomManager Rooms
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Match Game · @Code.ToUpperInvariant()</PageTitle>

@*
    This one page is every screen in a Match Game, with two web addresses like the other games:
      /match-game/ABCD         for people (the emcee and the celebrities). Phones scan the QR code and land here.
      /match-game/ABCD/board   for the big screen. It never joins; it only watches.
    The two contestant teams have no screens at all.
*@

@if (_game is null)
{
    <main class="card center">
        <h1>Game not found</h1>
        <p>There's no game with the code <strong>@Code.ToUpperInvariant()</strong>. It may have ended, or the server may have restarted.</p>
        <a class="btn" href="/match-game">Start or join a game</a>
    </main>
}
else if (!_ready)
{
    <main class="card center"><p class="muted">Connecting…</p></main>
}
else if (_snapshot.Phase == MatchPhase.Lobby)
{
    <MatchLobbyView Game="_game" Snapshot="_snapshot" Seat="_seat" Token="_token" BoardMode="_boardMode" Error="@_error" OnJoin="JoinAsync" />
}
else if (_boardMode)
{
    <MatchTvView Snapshot="_snapshot" />
}
else if (_seat.Role == Role.Emcee)
{
    <MatchEmceeView Game="_game" Snapshot="_snapshot" Token="_token" />
}
else if (_seat.Role == Role.Player)
{
    <MatchPlayerView Game="_game" Snapshot="_snapshot" Token="_token" CelebrityId="_seat.PlayerId!.Value" />
}
else
{
    @* A latecomer's phone: they can still join the panel, and they play from the next question. *@
    <MatchLateJoin Error="@_error" OnJoin="JoinAsync" />
    <MatchTvView Snapshot="_snapshot" />
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private MatchGame? _game;
    private MatchSnapshot _snapshot = default!;
    private Seat _seat = new(Role.Spectator);
    private Guid _token;
    private bool _ready;
    private bool _boardMode;
    private string? _error;

    // Testing aid: .../ABCD?seat=2 gives that tab its own saved seat, so one browser can play several people.
    private string StorageKey
    {
        get
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
            var slot = query.TryGetValue("seat", out var v) ? v.ToString() : "";
            return $"bg.match.{Code.ToUpperInvariant()}" + (slot.Length > 0 ? $".{slot}" : "");
        }
    }

    protected override void OnInitialized()
    {
        _boardMode = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/')
            .EndsWith("/board", StringComparison.OrdinalIgnoreCase);

        _game = Rooms.Find(Code);
        if (_game is null) return;

        _snapshot = _game.Snapshot();
        _game.Changed += OnGameChanged;

        if (_boardMode) _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _game is null || _boardMode) return;

        var saved = await JS.InvokeAsync<string?>("bg.getItem", StorageKey);
        if (Guid.TryParse(saved, out var token))
        {
            _token = token;
            _seat = _game.GetSeat(token);
        }

        _ready = true;
        StateHasChanged();
    }

    private void OnGameChanged() => _ = InvokeAsync(() =>
    {
        _snapshot = _game!.Snapshot();
        if (_token != Guid.Empty) _seat = _game.GetSeat(_token);
        StateHasChanged();
    });

    private async Task JoinAsync((Role Role, string Name) request)
    {
        _error = null;
        var result = request.Role == Role.Emcee ? _game!.JoinEmcee(request.Name) : _game!.JoinCelebrity(request.Name);
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        _token = result.Token;
        _seat = _game.GetSeat(_token);
        await JS.InvokeVoidAsync("bg.setItem", StorageKey, _token.ToString());
    }

    public void Dispose()
    {
        if (_game is not null) _game.Changed -= OnGameChanged;
    }
}
