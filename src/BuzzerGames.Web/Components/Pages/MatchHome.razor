@page "/match-game"
@inject MatchRoomManager Rooms
@inject NavigationManager Navigation

<PageTitle>Match Game</PageTitle>

<main class="card center jeopardy-home">
    <h1>Match Game</h1>
    <p class="muted">Create the game on the big screen (the TV). The emcee and the celebrities scan its QR code, or open this site on their phones and type the room code below. The two contestant teams don't need phones; they just say their answers out loud.</p>

    <button class="btn btn-start" @onclick="CreateGame">Create a new game</button>

    <hr />

    <h2>Have a room code?</h2>
    <div class="button-row">
        <input class="text-input code-input" placeholder="ABCD" maxlength="4"
               @bind="_code" @bind:event="oninput" @onkeydown="OnKeyDown" />
        <button class="btn" @onclick="JoinGame">Go</button>
    </div>
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <a class="back-link" href="/">All games</a>
</main>

@code {
    private string _code = "";
    private string? _error;

    private void CreateGame()
    {
        var game = Rooms.Create();
        Navigation.NavigateTo($"/match-game/{game.Code}/board");
    }

    private void JoinGame()
    {
        var game = Rooms.Find(_code);
        if (game is null)
        {
            _error = "We couldn't find a game with that code.";
            return;
        }
        Navigation.NavigateTo($"/match-game/{game.Code}");
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") JoinGame();
    }
}
