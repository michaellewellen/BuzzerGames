@*
    A little cartoon person, drawn in SVG from five numbers (skin, hair, hair color, shirt, glasses). Original art, no photos.
    Pose "cheer" throws both arms up; the default "stand" keeps them down (they would be behind the podium anyway).
*@

<svg class="pr-avatar @Class" viewBox="0 0 100 132" role="img" aria-label="@Label">
    @* hair behind the head *@
    @if (Avatar.Hair == 3)
    {
        <circle cx="50" cy="38" r="31" fill="@HairColor" />
    }
    @if (Avatar.Hair == 2)
    {
        <path d="M24,56 Q18,22 50,20 Q82,22 76,56 L80,92 L20,92 Z" fill="@HairColor" />
    }
    @if (Avatar.Hair == 4)
    {
        <ellipse cx="80" cy="62" rx="8" ry="15" fill="@HairColor" />
    }

    @if (Pose == "cheer")
    {
        <line x1="22" y1="100" x2="9" y2="58" stroke="@ShirtColor" stroke-width="12" stroke-linecap="round" />
        <line x1="78" y1="100" x2="91" y2="58" stroke="@ShirtColor" stroke-width="12" stroke-linecap="round" />
        <circle cx="8" cy="52" r="7" fill="@SkinColor" />
        <circle cx="92" cy="52" r="7" fill="@SkinColor" />
    }

    <path d="M8,132 L8,112 Q8,94 30,90 L70,90 Q92,94 92,112 L92,132 Z" fill="@ShirtColor" />
    <path d="M40,90 L50,104 L60,90 Z" fill="@SkinColor" />
    <rect x="42" y="74" width="16" height="18" rx="4" fill="@SkinColor" />
    <circle cx="27.5" cy="54" r="4" fill="@SkinColor" />
    <circle cx="72.5" cy="54" r="4" fill="@SkinColor" />
    <ellipse cx="50" cy="52" rx="23" ry="26" fill="@SkinColor" />

    @* hair in front *@
    @switch (Avatar.Hair)
    {
        case 0:
            <path d="M27,50 Q25,25 50,24 Q75,25 73,50 Q70,35 50,35 Q30,35 27,50 Z" fill="@HairColor" />
            break;
        case 2:
            <path d="M27,52 Q24,26 50,25 Q76,26 73,52 Q68,36 50,36 Q32,36 27,52 Z" fill="@HairColor" />
            break;
        case 3:
            <path d="M28,46 Q32,32 50,32 Q68,32 72,46 Q62,38 50,38 Q38,38 28,46 Z" fill="@HairColor" />
            break;
        case 4:
            <path d="M27,50 Q25,25 50,24 Q75,25 73,50 Q70,35 50,35 Q30,35 27,50 Z" fill="@HairColor" />
            break;
        case 5:
            <path d="M26,52 Q22,23 52,22 Q78,23 74,46 Q60,32 40,42 Q32,45 26,52 Z" fill="@HairColor" />
            break;
        default:
            break;   @* 1 = bald *@
    }

    <circle cx="41" cy="52" r="2.6" fill="#2a2a2a" />
    <circle cx="59" cy="52" r="2.6" fill="#2a2a2a" />
    <path d="M41,63 Q50,72 59,63" fill="none" stroke="#7a3b2e" stroke-width="2.4" stroke-linecap="round" />
    @if (Avatar.Glasses)
    {
        <circle cx="41" cy="52" r="8" fill="rgba(255,255,255,.18)" stroke="#2a2a2a" stroke-width="2" />
        <circle cx="59" cy="52" r="8" fill="rgba(255,255,255,.18)" stroke="#2a2a2a" stroke-width="2" />
        <line x1="49" y1="52" x2="51" y2="52" stroke="#2a2a2a" stroke-width="2" />
    }
</svg>

@code {
    public static readonly string[] Skins = ["#f6d5b8", "#eec09a", "#d9a273", "#b97c4f", "#8d5a36", "#5e3a22"];
    public static readonly string[] HairColors = ["#2b1d14", "#5a3a22", "#8a5a2b", "#d8b24a", "#b5482a", "#a9afb5"];
    public static readonly string[] Shirts = ["#e63946", "#2a9d8f", "#264653", "#f4a261", "#6a4c93", "#2b9348", "#f72585", "#1d3557"];

    [Parameter, EditorRequired] public Avatar Avatar { get; set; } = default!;
    [Parameter] public string Pose { get; set; } = "stand";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Label { get; set; } = "A person";

    private string SkinColor => Skins[Avatar.Skin];
    private string HairColor => HairColors[Avatar.HairColor];
    private string ShirtColor => Shirts[Avatar.Shirt];
}
